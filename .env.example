# Base de datos (Prisma / Supabase Postgres)
# DATABASE_URL: conexión pooled (pgbouncer, puerto 6543) — usada en runtime por la app
# DIRECT_URL: conexión directa (puerto 5432) — usada por el CLI de Prisma para migraciones
DATABASE_URL=
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Culqi
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Aplicación
NEXT_PUBLIC_SITE_URL=http://localhost:3000
